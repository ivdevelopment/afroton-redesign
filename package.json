{
  "name": "afroton-redesign",
  "version": "2.0.0",
  "private": true,
  "description": "Unofficial redesign concept for afroton.eu (not affiliated with Afroton)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "build:pages": "node src/build.mjs --pages --base=/afroton-redesign/",
    "dev": "node src/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "preview:pages": "node src/build.mjs --pages --base=/afroton-redesign/ && node scripts/serve.mjs --base=/afroton-redesign/",
    "check": "node scripts/check.mjs",
    "test": "node src/build.mjs && node --test tests/*.test.mjs"
  }
}
